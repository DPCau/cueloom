# CueLoom 环境变量模板
# 用法：ctl.sh 菜单 6 会把它复制为 .env；.env 已 gitignore，禁止提交。
# 优先级：环境变量 > .env > configs/local.yaml > configs/default.yaml

# --- 自有 LLM 服务（唯一翻译后端，OpenAI 兼容） ---
CUELOOM_LLM_BASE_URL=https://your-llm.example.com/v1
CUELOOM_LLM_API_KEY=replace-me
CUELOOM_LLM_MODEL=your-model-name
CUELOOM_LLM_CONCURRENCY=4
CUELOOM_LLM_QPM=
CUELOOM_LLM_TPM=

# --- 服务监听（默认仅本机，公网暴露需反向代理鉴权，D-11） ---
CUELOOM_HOST=127.0.0.1
CUELOOM_PORT=8000
CUELOOM_LOG_LEVEL=INFO

# --- 产物目录（相对项目根，留空用默认） ---
CUELOOM_WORK_DIR=work
CUELOOM_OUT_DIR=out
