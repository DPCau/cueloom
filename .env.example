# CueLoom 环境变量模板
# 用法：ctl.sh 菜单 6 会把它复制为权限 0600 的 .env；.env 已 gitignore，禁止提交。
# 优先级：环境变量 > .env > configs/local.yaml > configs/default.yaml

# --- 自有 LLM 服务（唯一翻译后端，OpenAI 兼容） ---
# 留空即视为未配置；看板与菜单 3 只显示「已设置 / 未设置」，不显示密钥值。
# 示例：CUELOOM_LLM_BASE_URL=https://your-llm.example.com/v1
# 示例：CUELOOM_LLM_API_KEY=sk-...
# 示例：CUELOOM_LLM_MODEL=your-model-name
CUELOOM_LLM_BASE_URL=
CUELOOM_LLM_API_KEY=
CUELOOM_LLM_MODEL=
CUELOOM_LLM_CONCURRENCY=4
CUELOOM_LLM_QPM=
CUELOOM_LLM_TPM=

# --- 服务监听（ADR-017：默认回环，本机自动通过，远端必须鉴权） ---
# ctl 只安全读取 HOST / PORT / LOG_LEVEL；其他配置由 app / ConfigProvider 读取。
# dotenv 不执行 shell 代码，不展开 ${...}；环境变量优先于 .env。
# 非回环启动由 app 校验至少 32 字符的随机高熵 token；不放入 URL / 日志。
# 非本机访问必须使用 HTTPS 或受信安全隧道；默认不信任代理头。
# Docker 内部监听 0.0.0.0，但仅发布到宿主回环；仍必须设置 token。
CUELOOM_WEB_TOKEN=
CUELOOM_HOST=127.0.0.1
CUELOOM_PORT=8000
CUELOOM_LOG_LEVEL=INFO

# --- 产物目录（相对项目根，留空用默认） ---
CUELOOM_WORK_DIR=work
CUELOOM_OUT_DIR=out
